{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rhinestone GSI tile source settings",
  "oneOf": [
    {
      "type": "object",
      "properties": {"id": {"type": "string", "minLength": 1}},
      "required": ["id"],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "scheme": {"const": "xyz"},
        "crs": {"const": "EPSG:3857"},
        "format": {"enum": ["png", "jpeg"]},
        "media_type": {"enum": ["image/png", "image/jpeg"]},
        "min_zoom": {"type": "integer", "minimum": 0, "maximum": 30},
        "max_zoom": {"type": "integer", "minimum": 0, "maximum": 30},
        "tile_size": {"const": 256},
        "attribution": {"type": "string", "minLength": 1},
        "title": {"type": "string"}
      },
      "required": ["url", "scheme", "crs", "format", "media_type", "min_zoom", "max_zoom", "tile_size", "attribution"],
      "additionalProperties": true,
      "anyOf": [
        {"properties": {"format": {"const": "png"}, "media_type": {"const": "image/png"}}},
        {"properties": {"format": {"const": "jpeg"}, "media_type": {"const": "image/jpeg"}}}
      ]
    }
  ]
}
